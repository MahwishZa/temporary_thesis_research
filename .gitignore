# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Secrets / credentials
.env
*.env

# PubMed backup files
data/corpora/pubmed/pubmed_results_backup_*.csv
data/corpora/pubmed/pubmed_results_backup_*.json
data/corpora/pubmed/search_log_backup_*.csv

# Temporary files
*.tmp
*.temp

# Downloaded PMC full text (research data, not source code).
# Reconstructible from data/corpora/pmc/pmc_oa_inventory.csv plus the manifest's
# MD5s. fulltext/manifest.csv and failures.csv are deliberately NOT ignored.
data/corpora/pmc/fulltext/xml/
data/corpora/pmc/fulltext/**/*.part

# Parsed article records (derived research data, not source code).
# Regenerable from the raw XML plus preprocessing/pmc/parse_pmc_xml.py; every record carries
# the source MD5, so a rebuild can be proven to match.
data/corpora/pmc/parsed/

# Scratch inventories produced while investigating acquisition failures. Not part
# of the corpus and never committed; retry71.csv is regenerable from the snippet
# in docs/quality_control/pmc_xml_retry_2026-09-02_outcome.md.
/retry71.csv

# Retrieval-ready chunks (derived research data, not source code).
# Regenerable deterministically from the parsed corpus plus the frozen M1-M4
# overlays via preprocessing/pmc/build_chunks.py. chunk_stats.json is deliberately
# NOT ignored:
# it is the committed evidence of the run.
data/corpora/pmc/chunks/chunks.jsonl

# Embedding index and retrieved candidate sets (derived, large, machine-specific).
# Rebuilt with preprocessing/pmc/embed_chunks.py on the machine holding the weights.
# A stub index must never be committed: it is not valid for thesis results.
indexes/production/
indexes/development/
experiments/runs/candidates/

# The evidence-quality de-blinding key. This file holds the SCAF and RAG2 scores
# for exactly the passages a human is judging, and committing it would put them
# one `git show` away from the annotator. Ignored wherever it appears, not just
# at its usual path, because a copy made for convenience de-blinds just as well.
# experiments/scripts/annotate.py additionally refuses to open any file whose
# name contains "key", so the interface cannot display these values either.
annotation_key.jsonl
**/annotation_key.jsonl

# Pytest cache
.pytest_cache/

# RAG2 baseline: run outputs and replayed candidate sets. Large, machine-specific
# and regenerable; every number that matters is traced by its run manifest instead.
runs/
cache/
architecture/rag2/runs/
architecture/rag2/cache/

# RAG2 baseline: corpus artifacts the user supplies
# (see architecture/rag2/retriever/README.md).
# The RAG2 authors do not redistribute the four biomedical corpora; these paths are
# where a local copy goes. This repository's own corpus lives under
# data/corpora/pmc/.
architecture/rag2/retriever/embeddings/**/*.npy
architecture/rag2/retriever/articles/**/*.json
architecture/rag2/retriever/input/*.json
architecture/rag2/retriever/output/*.json

# RAG2 baseline: trained filter checkpoints. Model weights, never source.
architecture/rag2/data/

# Hugging Face / MedCPT model weights, if a cache is ever pointed inside the repo.
# Model files are hundreds of MB and are re-downloadable from the model id.
.cache/
huggingface/
models--*/
*.safetensors

# SCAF experiment outputs: frozen candidate sets, per-question traces, manifests.
# Regenerable from the two scripts in experiments/scripts/; the question set and the
# configuration ARE committed, the run products are not.
experiments/runs/

# filelock artifacts. `datasets` takes a lock beside the working directory when
# run_classifier.py loads the training JSON, so filter training drops a .lock in
# architecture/rag2/ on every run. Empty, transient, never a deliverable.
*.lock

# TRANSFORMERS_CACHE is set to os.path.dirname(os.getcwd()) + '/cache' at the top
# of classifier/run_classifier.py (line 27, the authors' code, kept unmodified),
# which resolves to architecture/cache when filter training runs from
# architecture/rag2. Model weights, not source.
architecture/cache/
