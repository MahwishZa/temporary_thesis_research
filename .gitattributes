# Line-ending governance.
#
# Every generator in this repository writes LF explicitly (csv.writer with
# lineterminator="\n", open(..., newline=""), Path.write_text(..., newline="\n")).
# Without the rules below, a Windows checkout rewrites these files with CRLF, so
# the next regeneration reports phantom modifications and blocks a pull even
# though no data changed. Pinning eol=lf keeps checkout and regeneration
# byte-identical on every platform.
#
# Order matters: the LAST matching pattern wins, so the byte-exact and LFS
# overrides come after the general text rules.

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf
*.ipynb text eol=lf

# Byte-exact snapshots. These are pinned by MD5 and their provenance records
# that digest, so checkout must never alter a single byte. In particular
# data/pmc/currency_pack/xml/PMC13082890.xml is the Cochrane CD016297 snapshot
# (MD5 dcb1ac4eaa24b75ab3202f2315c6b2e4); CRLF conversion silently breaks it.
data/pmc/currency_pack/xml/** -text
data/pmc/fulltext/xml/**      -text

# The RAG2 authors' released code, vendored verbatim. "Unmodified" in
# docs/rag2_reproduction_audit.md means byte-identical to their release, so these
# trees must never be line-ending normalised -- retriever/README.md ships CRLF.
rag2/retriever/**        -text
rag2/classifier/**       -text

# Git LFS payloads: binary as far as git is concerned.
data/pubmed/pubmed_results.csv  filter=lfs diff=lfs merge=lfs -text
data/pubmed/pubmed_results.json filter=lfs diff=lfs merge=lfs -text
